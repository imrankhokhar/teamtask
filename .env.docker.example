# Copy to `.env` next to docker-compose.yml
PORT=4001
JWT_SECRET=teamtask-prod-secret-key-exodevs-2026
TEAMTASK_PUBLIC_URL=https://tt.exodevs.com

# Use local SQLite in Docker (recommended). Survives in the docker volume.
# When TEAMTASK_SQLITE=1, Cloudflare D1 is ignored even if credentials are set.
TEAMTASK_SQLITE=1

# Cloudflare D1 (optional; free tier = 100,000 rows_written / day)
# Comment these out (or keep TEAMTASK_SQLITE=1) if you hit the D1 write limit.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_D1_API_TOKEN=
