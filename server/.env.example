# =========================
# TeamTask — server .env
# Copy to: server/.env
# =========================

# --- Required ---
PORT=4000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string

# --- Shared cloud database (pick ONE) ---
#
# Recommended: free Postgres (Neon / Supabase / Railway).
# Paste the connection URI — same idea as Mongo URI before.
#
# Neon: https://console.neon.tech  → New project → Connection string
# Example:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL=

# Optional aliases (same as DATABASE_URL):
# POSTGRES_URI=
# TEAMTASK_DATABASE_URL=

# Legacy Mongo (optional — only used if DATABASE_URL is empty)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/teamtask?appName=teamtask
# MONGODB_DB=teamtask

# --- Recommended ---
TEAMTASK_PUBLIC_URL=https://tt.exodevs.com

TEAMTASK_WEB_DIST=./web
TEAMTASK_UPLOADS_DIR=./data/uploads

# Used only when DATABASE_URL and MONGODB_URI are both empty (local file DB)
TEAMTASK_DATA_DIR=./data
