# =========================
# TeamTask — server .env
# Copy to: server/.env
# =========================

# --- Required ---
PORT=4000
# Bind address: 127.0.0.1 locally; Docker sets HOST=0.0.0.0
# HOST=127.0.0.1
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string

# --- Database (pick ONE) ---
#
# Recommended for Cloudflare Tunnel / VPS / local: SQLite (no Neon)
# TEAMTASK_SQLITE=1                        → server/data/teamtask.sqlite
# TEAMTASK_SQLITE=./data/teamtask.sqlite   → custom path
TEAMTASK_SQLITE=1

# Optional remote Postgres (Neon / Supabase / Railway) — leave empty when using SQLite
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_URL=

# Legacy Mongo (only if SQLite and DATABASE_URL are both unset)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/teamtask?appName=teamtask
# MONGODB_DB=teamtask

# --- Recommended ---
TEAMTASK_PUBLIC_URL=https://tt.exodevs.com

TEAMTASK_WEB_DIST=./web
TEAMTASK_UPLOADS_DIR=./data/uploads
TEAMTASK_DATA_DIR=./data

# Local fallback when remote Postgres/Mongo is unreachable (dev only):
# TEAMTASK_DB_FALLBACK=file
# TEAMTASK_DB_FALLBACK=none
